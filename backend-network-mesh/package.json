{
  "name": "mesh-ts-backend",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.0.0 <25",
    "npm": ">=10"
  },
  "description": "Self-healing overlay mesh (SWIM gossip, lighthouse join brokers, service discovery) plus the dashboard control plane. Node built-ins only.",
  "type": "module",
  "scripts": {
    "lighthouse": "tsx src/lighthouse.ts",
    "node": "tsx src/node.ts",
    "typecheck": "tsc --noEmit",
    "demo": "bash scripts/demo.sh",
    "dev": "tsx backend/src/server.ts",
    "backend": "tsx backend/src/server.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
