# Copy to .env (docker compose reads it automatically; for the native route,
# `export` the same variables before `npm run dev`).

# Shared HMAC secret = the mesh's access key. Every packet is signed with it;
# lighthouses and nodes drop anything signed with a different key, so only
# holders of this value can join or talk. Every device must use the identical
# value. Any string works for a purely local demo; to join a real mesh, get the
# key from its operator out-of-band (chat, not git) — never commit the real one.
# Generate a fresh one with:  openssl rand -hex 32
MESH_KEY=local-demo-only-change-me

# Comma-separated host:port list of lighthouses on OTHER machines
# (e.g. a public VPS: "203.0.113.10:5001"). Every node the dashboard spawns
# joins these too, so the local fleet merges with peers across the internet.
# Leave empty for a fully self-contained local demo.
EXTRA_LIGHTHOUSES=

# How this machine is labelled on other devices' dashboards and on the
# signals it sends (e.g. "mac-mini-1", "gcs-laptop").
DEVICE_NAME=my-device
