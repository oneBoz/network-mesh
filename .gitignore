# dependencies / build output (per-package .gitignore files also cover these)
**/node_modules/
**/dist/

# environment / secrets — keep only the example
.env
.env.*
!.env.example

# control-plane state when running natively (Docker uses the mesh-data volume)
.data/

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
